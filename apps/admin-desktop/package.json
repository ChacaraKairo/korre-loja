{
  "name": "@korre/admin-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0 --port 5174\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5174 dist/main/main.js && electron .\"",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@korre/shared": "*",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.4"
  }
}
