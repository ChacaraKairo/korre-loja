{
  "name": "@korre/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build -w @korre/shared && nest start --watch",
    "build": "npm run build -w @korre/shared && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@korre/shared": "*",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.13.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.5",
    "@types/node": "^24.1.0",
    "prisma": "^6.13.0",
    "typescript": "^5.9.2"
  }
}
