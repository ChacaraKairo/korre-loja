{
  "name": "korre-loja",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo TypeScript da Loja do Korre: site, API e admin desktop.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @korre/web-store",
    "dev:api": "npm run dev -w @korre/api",
    "dev:desktop": "npm run dev -w @korre/admin-desktop",
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w @korre/shared && npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w @korre/api",
    "db:push": "npm run prisma:push -w @korre/api",
    "db:seed": "npm run seed -w @korre/api"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  }
}
